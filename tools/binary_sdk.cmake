include_guard(GLOBAL)

# Install a checked, relocatable binary SDK without compiling its private core.
# This helper uses the target platform, so a real RISC-V toolchain also works
# when CMake itself runs on another architecture.
function(_spacemit_binary_json_get manifest output)
    string(JSON _value ERROR_VARIABLE _error GET "${manifest}" ${ARGN})
    if(NOT _error STREQUAL "NOTFOUND")
        string(JOIN "/" _field ${ARGN})
        message(FATAL_ERROR "Invalid binary SDK manifest field ${_field}: ${_error}")
    endif()
    set(${output} "${_value}" PARENT_SCOPE)
endfunction()

function(_spacemit_binary_relative_path path)
    if("${path}" STREQUAL "" OR IS_ABSOLUTE "${path}" OR
       "${path}" MATCHES "(^|/)\\.\\.?(/|$)" OR
       "${path}" MATCHES "[;\\\\]" OR "${path}" MATCHES "//")
        message(FATAL_ERROR "Binary SDK paths must be normalized relative paths: ${path}")
    endif()
endfunction()

function(spacemit_install_binary_sdk package license_directory)
    string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _consumer_processor)
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR
       NOT _consumer_processor MATCHES "^riscv64($|[-_])")
        message(FATAL_ERROR
            "${package} contains Linux/riscv64 prebuilt libraries; the selected target is "
            "${CMAKE_SYSTEM_NAME}/${CMAKE_SYSTEM_PROCESSOR}. Use a matching K3 target toolchain.")
    endif()

    set(_payload "${CMAKE_CURRENT_SOURCE_DIR}")
    set(_manifest_file "${_payload}/manifest.json")
    if(NOT EXISTS "${_manifest_file}" OR IS_DIRECTORY "${_manifest_file}" OR
       IS_SYMLINK "${_manifest_file}")
        message(FATAL_ERROR "${package}: missing binary SDK manifest ${_manifest_file}")
    endif()
    file(REAL_PATH "${_payload}" _payload_real)
    file(READ "${_manifest_file}" _manifest)
    _spacemit_binary_json_get("${_manifest}" _schema schema_version)
    _spacemit_binary_json_get("${_manifest}" _package package)
    _spacemit_binary_json_get("${_manifest}" _system target system)
    _spacemit_binary_json_get("${_manifest}" _processor target processor)
    _spacemit_binary_json_get("${_manifest}" _elf_class target elf_class)
    _spacemit_binary_json_get("${_manifest}" _endianness target endianness)
    _spacemit_binary_json_get("${_manifest}" _isa target isa)
    _spacemit_binary_json_get("${_manifest}" _abi target abi)
    if(NOT _schema STREQUAL "1" OR NOT _package STREQUAL "${package}")
        message(FATAL_ERROR "${package}: binary SDK schema or package does not match this package")
    endif()
    if(NOT _system STREQUAL "Linux" OR NOT _processor STREQUAL "riscv64" OR
       NOT _elf_class STREQUAL "64" OR NOT _endianness STREQUAL "little" OR
       NOT _abi STREQUAL "lp64d" OR _isa STREQUAL "")
        message(FATAL_ERROR "${package}: expected a declared Linux/riscv64 ELF64 little-endian LP64D SDK")
    endif()

    foreach(_directory IN ITEMS include lib)
        if(NOT IS_DIRECTORY "${_payload}/${_directory}")
            message(FATAL_ERROR "${package}: binary SDK is missing ${_directory}/")
        endif()
        if(IS_SYMLINK "${_payload}/${_directory}")
            message(FATAL_ERROR "${package}: directory symlinks are not supported: ${_directory}")
        endif()
    endforeach()

    string(JSON _files_type ERROR_VARIABLE _error TYPE "${_manifest}" files)
    if(NOT _error STREQUAL "NOTFOUND" OR NOT _files_type STREQUAL "OBJECT")
        message(FATAL_ERROR "${package}: manifest files must be an object of relative paths and SHA256 values")
    endif()
    string(JSON _file_count LENGTH "${_manifest}" files)
    if(_file_count LESS 1)
        message(FATAL_ERROR "${package}: binary SDK manifest contains no files")
    endif()
    set(_declared_files)
    math(EXPR _last_file "${_file_count} - 1")
    foreach(_index RANGE 0 ${_last_file})
        string(JSON _relative MEMBER "${_manifest}" files ${_index})
        _spacemit_binary_relative_path("${_relative}")
        if(_relative STREQUAL "manifest.json")
            message(FATAL_ERROR "${package}: manifest.json must not list its own checksum")
        endif()
        if(NOT _relative MATCHES "^(include|lib)/")
            message(FATAL_ERROR "${package}: binary SDK file is outside include/ and lib/: ${_relative}")
        endif()
        set(_file "${_payload}/${_relative}")
        if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}")
            message(FATAL_ERROR "${package}: missing binary SDK file ${_relative}")
        endif()
        if(IS_SYMLINK "${_file}")
            file(READ_SYMLINK "${_file}" _link_target)
            if(IS_ABSOLUTE "${_link_target}")
                message(FATAL_ERROR "${package}: binary SDK symlinks must be relative: ${_relative}")
            endif()
        endif()
        file(REAL_PATH "${_file}" _real_file)
        file(RELATIVE_PATH _resolved_relative "${_payload_real}" "${_real_file}")
        if(NOT _resolved_relative MATCHES "^(include|lib)/")
            message(FATAL_ERROR "${package}: binary SDK symlink escapes its payload: ${_relative}")
        endif()
        _spacemit_binary_json_get("${_manifest}" _expected_sha files "${_relative}")
        string(LENGTH "${_expected_sha}" _sha_length)
        if(NOT _sha_length EQUAL 64 OR NOT _expected_sha MATCHES "^[0-9a-fA-F]+$")
            message(FATAL_ERROR "${package}: invalid SHA256 for ${_relative}")
        endif()
        file(SHA256 "${_file}" _actual_sha)
        string(TOLOWER "${_expected_sha}" _expected_sha)
        if(NOT _actual_sha STREQUAL _expected_sha)
            message(FATAL_ERROR "${package}: SHA256 mismatch for ${_relative}")
        endif()
        list(APPEND _declared_files "${_relative}")
    endforeach()

    # Inventory only the installed payload directories. Module build files and
    # source-tree documents live alongside these directories.
    file(GLOB_RECURSE _entries LIST_DIRECTORIES TRUE RELATIVE "${_payload}"
        "${_payload}/include/*" "${_payload}/lib/*")
    set(_actual_files)
    foreach(_relative IN LISTS _entries)
        set(_file "${_payload}/${_relative}")
        if(IS_DIRECTORY "${_file}")
            if(IS_SYMLINK "${_file}")
                message(FATAL_ERROR "${package}: directory symlinks are not supported: ${_relative}")
            endif()
        else()
            list(APPEND _actual_files "${_relative}")
        endif()
    endforeach()
    list(SORT _declared_files)
    list(SORT _actual_files)
    if(NOT "${_actual_files}" STREQUAL "${_declared_files}")
        message(FATAL_ERROR "${package}: binary SDK payload and manifest file inventory differ")
    endif()

    string(JSON _libraries_type ERROR_VARIABLE _error TYPE "${_manifest}" libraries)
    if(NOT _error STREQUAL "NOTFOUND" OR NOT _libraries_type STREQUAL "ARRAY")
        message(FATAL_ERROR "${package}: manifest libraries must be an array")
    endif()
    string(JSON _library_count LENGTH "${_manifest}" libraries)
    if(_library_count LESS 1)
        message(FATAL_ERROR "${package}: binary SDK contains no shared libraries")
    endif()
    set(_libraries)
    math(EXPR _last_library "${_library_count} - 1")
    foreach(_index RANGE 0 ${_last_library})
        _spacemit_binary_json_get("${_manifest}" _library libraries ${_index})
        _spacemit_binary_relative_path("${_library}")
        if(NOT _library MATCHES "^lib/[^/]+\\.so(\\.[0-9]+)*$" OR
           NOT _library IN_LIST _declared_files)
            message(FATAL_ERROR "${package}: invalid or unlisted shared library ${_library}")
        endif()
        file(SIZE "${_payload}/${_library}" _library_size)
        if(_library_size LESS 64)
            message(FATAL_ERROR "${package}: invalid ELF header in ${_library}")
        endif()
        file(READ "${_payload}/${_library}" _elf LIMIT 64 HEX)
        string(SUBSTRING "${_elf}" 0 8 _magic)
        string(SUBSTRING "${_elf}" 8 2 _class)
        string(SUBSTRING "${_elf}" 10 2 _data)
        string(SUBSTRING "${_elf}" 32 4 _type)
        string(SUBSTRING "${_elf}" 36 4 _machine)
        if(NOT _magic STREQUAL "7f454c46" OR NOT _class STREQUAL "02" OR
           NOT _data STREQUAL "01" OR NOT _type STREQUAL "0300" OR
           NOT _machine STREQUAL "f300")
            message(FATAL_ERROR "${package}: ${_library} is not a Linux RISC-V ELF64 little-endian shared object")
        endif()
        string(SUBSTRING "${_elf}" 96 2 _flags_0)
        string(SUBSTRING "${_elf}" 98 2 _flags_1)
        string(SUBSTRING "${_elf}" 100 2 _flags_2)
        string(SUBSTRING "${_elf}" 102 2 _flags_3)
        math(EXPR _float_abi "0x${_flags_3}${_flags_2}${_flags_1}${_flags_0} & 6")
        if(NOT _float_abi EQUAL 4)
            message(FATAL_ERROR "${package}: ${_library} does not use the declared LP64D floating-point ABI")
        endif()
        list(APPEND _libraries "${_library}")
    endforeach()
    foreach(_relative IN LISTS _actual_files)
        if(_relative MATCHES "\\.so(\\.[0-9]+)*$" AND NOT _relative IN_LIST _libraries)
            message(FATAL_ERROR "${package}: shared library omitted from libraries inventory: ${_relative}")
        endif()
    endforeach()

    foreach(_required IN ITEMS
            "include/${package}.h"
            "lib/cmake/${package}/${package}Config.cmake"
            "lib/cmake/${package}/${package}Targets.cmake")
        if(NOT _required IN_LIST _declared_files)
            message(FATAL_ERROR "${package}: binary SDK is missing ${_required}")
        endif()
    endforeach()
    get_filename_component(_license_dir "${license_directory}" ABSOLUTE
        BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
    foreach(_name IN ITEMS LICENSE NOTICE)
        set(_file "${_license_dir}/${_name}")
        if(NOT EXISTS "${_file}" OR IS_DIRECTORY "${_file}" OR IS_SYMLINK "${_file}")
            message(FATAL_ERROR "${package}: expected a regular binary SDK license file: ${_name}")
        endif()
        install(FILES "${_file}" DESTINATION "share/licenses/spacemit-vslam")
    endforeach()
    foreach(_directory IN ITEMS include lib)
        install(DIRECTORY "${_payload}/${_directory}/" DESTINATION "${_directory}"
            USE_SOURCE_PERMISSIONS)
    endforeach()
    install(FILES "${_manifest_file}" DESTINATION "share/${package}/binary_sdk")
    message(STATUS "${package}: verified ${_file_count} files from the RISC-V binary SDK")
endfunction()
