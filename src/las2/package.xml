<?xml version="1.0"?>
<package format="3">
  <name>las2</name>
  <version>0.1.0</version>
  <description>Asynchronous MPP DMA-BUF to LAS2 stereo-depth ROS 2 node.</description>
  <maintainer email="guoshu@example.com">guoshu</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>builtin_interfaces</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>mpp_msgs</depend>
  <depend>common</depend>
  <depend>libopencv-dev</depend>
  <exec_depend>python3</exec_depend>

  <depend>stereo_matching</depend>


  <depend>mpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <system_depend realm="target">libopencv-dev</system_depend>
    <system_depend realm="target">ocl-icd-opencl-dev</system_depend>
  </export>
</package>
